{
  "name": "lammah-search",
  "version": "1.0.0",
  "private": true,
  "description": "لمّاح — Saudi plate search (web + Android)",
  "scripts": {
    "sync:www": "node scripts/sync-www.mjs",
    "gen:gemini-examples": "node scripts/gen-gemini-plate-examples.mjs",
    "cap:sync": "npm run sync:www && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "capacitor": {
    "platforms": [
      "android"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/browser": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capgo/capacitor-speech-recognition": "^7.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0"
  }
}
